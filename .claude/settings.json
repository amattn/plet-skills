{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0"
  },
  "permissions": {
    "allow": [
      "Bash(./skills/plet/scripts/*)",
      "Bash(./skills/plet/tests/*)",
      "Bash(skills/plet/scripts/*)",
      "Bash(skills/plet/tests/*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/ruff --version)",
      "Bash(git:*)",
      "Bash(ruff:*)",
      "Bash(uv:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(grep:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(sed:*)",
      "Bash(shasum)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "WebFetch(domain:gist.github.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git push)"
    ]
  }
}
